# SahaaySetu Server Environment Configuration
# Copy this file to .env and provide your values.
# NEVER commit sensitive API keys to source control.

PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key (Required for live Gemini analysis; leave blank for deterministic Demo Mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (defaults to gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
MAX_UPLOAD_SIZE_BYTES=5242880
